# deploy/.env.deploy.template
# Rendered into /opt/ruxsatnoma-api/.env ON THE SERVER by Task 3's bootstrap script, which
# generates the three secrets below and substitutes them into this template with envsubst.
# This file is the documentation of what the server needs; it is never itself deployed.

# --- generated once, never rotated casually ---------------------------------
# SECRET_KEY is both the cookie signing key and the Fernet key for encrypted columns
# (users.mfa_secret): changing it forces every operator to re-enrol their MFA.
# Generate: openssl rand -hex 32
SECRET_KEY=${SECRET_KEY}
# Generate: openssl rand -hex 24  — baked into the pgdata volume on first start
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
# Generate: openssl rand -hex 24  — baked into the miniodata volume on first start
S3_SECRET_KEY=${S3_SECRET_KEY}

POSTGRES_USER=ruxsatnoma
POSTGRES_DB=ruxsatnoma
S3_ACCESS_KEY=ruxsatnoma

# --- wiring inside the compose network --------------------------------------
DATABASE_URL=postgresql+asyncpg://ruxsatnoma:${POSTGRES_PASSWORD}@db:5432/ruxsatnoma
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ruxsatnoma

# --- environment ------------------------------------------------------------
# dev, NOT prod: app_env=prod refuses to start while any adapter is a mock, and OneID,
# E-IMZO, Payme and Eskiz are all mocks until stage 5.
APP_ENV=dev
LOG_FORMAT=json
WORKERS_MODE=embedded

# TLS is terminated by Caddy, so the cookies must be Secure even though app_env is dev.
# With cors_origins non-empty this is also what makes them SameSite=None, which the
# cross-origin adminka requires in order to log in at all.
COOKIE_SECURE=true
CORS_ORIGINS=["https://dev-admin.ruxsatnoma-urmon.uz","https://dev.ruxsatnoma-urmon.uz"]

# The API origin — Eskiz's delivery callback is built from it. The printed QR is built
# from it too and points at /check, which Caddy routes to the landing (ruling R5).
PUBLIC_BASE_URL=https://dev-api.ruxsatnoma-urmon.uz
ONEID_REDIRECT_URI=https://dev-api.ruxsatnoma-urmon.uz/api/v1/auth/oneid/callback

# --- adapters: all mocks on dev ---------------------------------------------
ONEID_MODE=mock
EIMZO_MODE=mock
SMS_MODE=mock
EMAIL_MODE=mock
PAYME_MODE=mock

# --- permits ----------------------------------------------------------------
# CYRILLIC CAPITAL А (U+0410). A Latin A matches no counter row and issuance fails
# with ERR-SYS-001.
PERMIT_SERIES=А
