DB_USER=ruxsatnoma
DB_PASSWORD=
MQ_USER=ruxsatnoma
MQ_PASSWORD=
MINIO_USER=ruxsatnoma
MINIO_PASSWORD=

# Database roles created by db/01-roles.sql
CORE_PASSWORD=
OVERSIGHT_RO_PASSWORD=
MIGRATOR_PASSWORD=

# Application settings, read by core/config.py. Hosts and ports match the
# docker-compose defaults above; fill in the same passwords.
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://ruxsatnoma:@localhost:5442/ruxsatnoma_core
REDIS_URL=redis://localhost:6389/0
RABBITMQ_URL=amqp://ruxsatnoma:@localhost:5682/
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=ruxsatnoma
MINIO_SECRET_KEY=
MINIO_SECURE=false
