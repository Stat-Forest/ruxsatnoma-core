# Подключение к БД (asyncpg)
DATABASE_URL=postgresql+asyncpg://ruxsatnoma:ruxsatnoma@localhost:5432/ruxsatnoma
DATABASE_URL_TEST=postgresql+asyncpg://ruxsatnoma:ruxsatnoma@localhost:5432/ruxsatnoma_test

# Приложение
APP_ENV=dev            # dev | test | prod
LOG_FORMAT=console     # console | json
# sessions/cookie signing AND Fernet key for encrypted columns (users.mfa_secret):
# changing it invalidates all stored MFA secrets (re-enrollment required)
SECRET_KEY=change-me

# Session lifetime, idle timeout, login lockout and MFA policy are no longer
# deployment config — they live in the system_settings table (code defaults in
# app/core/settings_store.py), overridable at runtime via the admin API.

# Cross-origin adminka (stage 3.3a ruling 3). JSON list; empty means same-origin only.
# CORS_ORIGINS=["https://admin.ruxsatnoma.uz"]

# Applicant login (stage 3.2b): mock adapters; real ones arrive at stages 5.1/5.2/5.4 and app_env=prod forbids mock
ONEID_MODE=mock
EIMZO_MODE=mock
SMS_MODE=mock
ONEID_REDIRECT_URI=http://localhost:8000/api/v1/auth/oneid/callback
# The adminka origin: after OneID authenticates the citizen, the callback redirects the
# browser here (with the session cookies already set), to {ADMIN_BASE_URL}/auth/oneid/return.
ADMIN_BASE_URL=http://localhost:5173

# Объектное хранилище
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ruxsatnoma
S3_SECRET_KEY=ruxsatnoma-secret
S3_BUCKET=ruxsatnoma

# Notifications (stage 3.5): SMS via Eskiz, email via SMTP. app_env=prod requires
# full credentials once sms_mode/email_mode is "real" (app/config.py).
# Every line here must be a value the app can START on: `cp .env.example .env` is
# the documented first step, and pydantic-settings does NOT ignore an empty value —
# `EMAIL_MODE=` fails the Literal, `SMTP_PORT=` fails int, `ESKIZ_BASE_URL=` would
# replace a working default with "". Credentials are commented out instead.
EMAIL_MODE=mock
# Ruling #124: PUBLIC_BASE_URL split into two settings once these stopped
# living on one host (stage 7.0). PUBLIC_BASE_URL is the PUBLIC SITE a citizen's
# browser opens — permits.service.qr_url builds the printed QR from it, and a
# permit's QR is rendered once and cannot be corrected afterwards.
PUBLIC_BASE_URL=http://localhost:8000
# ESKIZ_CALLBACK_BASE_URL is OUR OWN API's externally reachable origin: Eskiz
# posts delivery reports to
# {ESKIZ_CALLBACK_BASE_URL}/api/v1/webhooks/eskiz/{ESKIZ_CALLBACK_SECRET}. A
# localhost value on either setting is rejected outright once the OTHER one is
# no longer local (app/config.py) — every delivery report would be lost
# silently, or every future permit would print a broken QR.
ESKIZ_CALLBACK_BASE_URL=http://localhost:8000
ESKIZ_BASE_URL=https://notify.eskiz.uz

# Required once SMS_MODE=real (stage 5.4). ESKIZ_CALLBACK_SECRET must be long and
# random — it is the ONLY authentication on the delivery-report endpoint.
# ESKIZ_EMAIL=robot@example.uz
# ESKIZ_PASSWORD=
# ESKIZ_SENDER=4546
# ESKIZ_CALLBACK_SECRET=

# Required once EMAIL_MODE=real (SMTP_USER/SMTP_PASSWORD only for an authenticated relay).
SMTP_PORT=587
SMTP_STARTTLS=true
# SMTP_HOST=smtp.example.uz
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Ruxsatnoma <noreply@example.uz>

# Payments (stage 3.10a): the Payme JSON-RPC server (design/04 §3). app_env=prod
# forbids PAYME_MODE=mock, same as the applicant-login adapters above — but unlike
# those, "mock" here means Payme's own SANDBOX cashbox key, not a fake (Payme
# provides a sandbox with separate test/production keys, design/04 §3.10).
# PAYME_MODE=real requires both PAYME_MERCHANT_ID and PAYME_CASHBOX_KEY (app/config.py).
PAYME_MODE=mock
# Required once PAYME_MODE=real. PAYME_CASHBOX_KEY is the ONLY authentication on
# the JSON-RPC endpoint (Authorization: Basic base64("Paycom:<key>")) — long and
# random, and rotate it if it is ever exposed (§7 — the old repo leaked one in
# plaintext).
# PAYME_MERCHANT_ID=
# PAYME_CASHBOX_KEY=

# External checks (stage 3.9b): veterinary registry and cadastre, both with no
# verified contract yet (tz/09 rows 5-6) — unlike the adapters above, prod may
# START in mock (nothing schedules a real one), but `get_adapter()` itself
# refuses to ANSWER a check with a mock verdict once app_env=prod (app/
# config.py) — a production check goes through the paper fallback instead.
VET_MODE=mock
CADASTRE_MODE=mock
# Permits (stage 3.11a). The series `permit_counters` hands numbers out under —
# CYRILLIC CAPITAL А (U+0410), not Latin A (U+0041). The two look identical and
# are different bytes: a Latin A matches no counter row and issuance refuses with
# ERR-SYS-001 rather than writing a permit without a number.
PERMIT_SERIES=А
